# Docker Compose reads this file for compose.yaml. A variable set in your shell takes
# precedence over its value here, so you can change one without editing this file.

# Temporal Server 1.31.2, as the demo's profiles say, and the UI that Temporal CLI 1.8.0 runs
# beside it.
TEMPORAL_VERSION=1.31.2
TEMPORAL_UI_VERSION=2.50.1
POSTGRES_VERSION=17.11-alpine
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=13.2.4

# Where each image is pulled from, without its tag: Docker Hub as written here. To pull
# through a mirror or from a private registry, put its address in front, as in
# registry.example.com/temporalio/server. On Docker Hub, postgres is library/postgres, the
# path a mirror usually keeps.
TEMPORAL_SERVER_IMAGE=temporalio/server
TEMPORAL_ADMIN_TOOLS_IMAGE=temporalio/admin-tools
TEMPORAL_UI_IMAGE=temporalio/ui
POSTGRES_IMAGE=postgres
PROMETHEUS_IMAGE=prom/prometheus
GRAFANA_IMAGE=grafana/grafana

# The dashboards directory of your copy of tsurdilo/temporal-server-operations, relative to
# this directory or absolute: as written, a checkout beside this repository's. Grafana loads
# the Temporal Server and Core SDK dashboards from it.
OPS_DASHBOARDS=../../temporal-server-operations/observability/dashboards
